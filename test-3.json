    {
      "name": "4. Get Jobs and Verify",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Check job with ID 7 and company name\", function () {",
              "    const responseData = pm.response.json();",
              "    const jobs = responseData.data.content; // Page 객체의 content 필드 참조",
              "    const targetJob = jobs.find(job => job.id === 7);",
              "    ",
              "    pm.expect(targetJob).to.not.be.undefined;",
              "    pm.expect(targetJob.companyName).to.eql(\"SK키파운드리\");",
              "    pm.expect(targetJob.status).to.eql(\"APPROVED\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/jobs",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "jobs"
          ]
        }
      },
